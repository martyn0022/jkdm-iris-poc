# Copy to .env and adjust if ports collide.
#
# ---------------------------------------------------------------
# ---------------------------------------------------------------
# Apple silicon / ARM: nothing to change. Every image here is
# multi-arch except the SFTP server, which publishes linux/amd64
# only and runs under emulation. Docker Desktop handles that once
# Rosetta is enabled:
#   Settings > General > "Use Rosetta for x86_64/amd64 emulation"
#
# If you later swap in a native arm64 SFTP image, set this to
# linux/arm64 to stop emulating.

# ---------------------------------------------------------------
# PORTS
# ---------------------------------------------------------------
# IRIS deliberately does NOT use the stock 52773/1972. A developer
# machine very often already has an IRIS instance holding those,
# and the failure mode is ugly: every other container comes up
# healthy and only IRIS dies with "port is already allocated".
#
# 52774/1973 sit next to the defaults so they are still obviously
# IRIS, without fighting an existing install for them.
IRIS_WEB_PORT=52774
IRIS_SUPER_PORT=1973

# Change these too if you have a local Postgres or something on 808x.
# Every script reads this file, so they follow automatically. The
# Management Portal URLs written in docs/ do not - update those by
# hand if you move IRIS again.
PG_USER=jkdm
PG_PASSWORD=jkdm_poc
PG_DB=smk
PG_PORT=5432

COBOL_PORT=8081
COBOL_LATENCY_MIN=200
COBOL_LATENCY_MAX=400

PHP_PORT=8082
SFTP_PORT=2222
